# Browser-accessible backend URL; embedded in the frontend image at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Required by the frontend at runtime. Replace with your Clerk secret key.
CLERK_SECRET_KEY=sk_test_replace_with_your_key

# Local image names are valid defaults. Replace with full ECR URLs on EC2.
BACKEND_REPO=carta-backend
FRONTEND_REPO=carta-frontend
IMAGE_TAG=v1.0.0
